.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Dependency directories
vendor/

# Generated protobuf files are committed for client usage
# api/**/*.pb.go
# api/**/*_grpc.pb.go

# Test generated files
test/generated/

# EasyP generated files
easyp.lock
.kiro/

# Serena tool workspace: local project config and cache.
.serena/
/easyp-svc
.tmp/

# Development TLS material generated by `task certs`
certs/

# Plugin caches the dev stack bind-mounts, one per tier. Not covered by the
# plugins/ rule above, which matches that name exactly.
deploy/plugins-community/
deploy/plugins-enterprise/

# Whatever the compose stack reads for secrets. deploy/.env.example and
# deploy/.env.dev.example are the committed templates; the real ones are not.
deploy/.env
deploy/.env.dev
# Carries the address Let's Encrypt writes to, which belongs to a deployment
# rather than to the repository. Copied from the .example beside it.
deploy/observability/traefik/traefik.public.yml

