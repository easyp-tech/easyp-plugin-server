# EasyP API Service — Environment Variables
# Copy to .env and uncomment the values you need.

# --- Ports (docker-compose) ---
# EASYP_TRAEFIK_PORT=80
# EASYP_TRAEFIK_TLS_PORT=4443
# EASYP_GRAFANA_PORT=3000
# EASYP_REGISTRY_PORT=5005
# EASYP_POSTGRES_PORT=5432
# The gRPC port is intentionally absent: the service is reached through traefik
# on EASYP_TRAEFIK_TLS_PORT, which is the only holder of a client certificate.
# EASYP_METRICS_PORT=8081
# EASYP_HEALTH_PORT=8082
# EASYP_GATEWAY_PORT=8083

# --- Container user (Linux only) ---
# The service image runs as UID 65532. ./plugins is bind-mounted from the host,
# so on Linux the container UID must match the directory owner or the service
# cannot unpack plugins. Uncomment and set to your own ids:
# EASYP_UID=1000
# EASYP_GID=1000

# --- Write token ---
# Authorises CreatePlugin/UpdatePlugin/DeletePlugin. Generate a token and the
# matching config entry with: easyp-svc auth new-token --name ci
# The digest goes into auth.write_tokens in deploy/config/config.yml; the token goes here.
# EASYP_TOKEN=

# --- Binary storage ---
# deploy/config/config.yml points at the rustfs container of the dev stack. To read plugin
# archives from a remote S3-compatible store instead, override it here; the
# same credentials are what `easyp-svc plugins push` needs to write there.
# REGISTRY_S3_ENDPOINT=https://storage.example.com
# REGISTRY_S3_BUCKET=easyp-plugins
# REGISTRY_S3_REGION=us-east-1
# REGISTRY_S3_FORCE_PATH_STYLE=true
# REGISTRY_S3_ACCESS_KEY_ID=
# REGISTRY_S3_SECRET_ACCESS_KEY=

# --- Enterprise License (uncomment both to enable) ---
# Ed25519 public key (hex) the token is verified against. Read at runtime, so it
# can also be set as license.public_key in deploy/config/config.yml.
# LICENSE_PUBLIC_KEY=c4c720019f4c70dcb30f3cdbac7f73689c6e027d02cb8ae8c5a3cbe654cfb6e0
# PASETO v4.public token — passed to service at runtime (tier=enterprise, 10yr expiry)
# LICENSE_KEY=v4.public.eyJleHAiOiIyMDM2LTAzLTEyVDIwOjIwOjE0KzAzOjAwIiwiaWF0IjoiMjAyNi0wMy0xNVQyMDoyMDoxNCswMzowMCIsIm1heF9wbHVnaW5zIjoiLTEiLCJtYXhfd29ya2VycyI6IjE2Iiwic3ViIjoidGVzdC1kZXYtbGljZW5zZSIsInRpZXIiOiJlbnRlcnByaXNlIn0qc0ELh3_NyDNOPxfreo8MH2dGeaFrkax-78CSmM2B06hfjmWIU-bp5aO98TIHpMO8MXNuS9nqaXiCEGqpOXEP
