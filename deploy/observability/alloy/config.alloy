// OTLP Receiver - accepts traces, metrics, and logs via OTLP
otelcol.receiver.otlp "default" {
  grpc { endpoint = "0.0.0.0:4317" }
  http { endpoint = "0.0.0.0:4318" }

  output {
    metrics = [otelcol.exporter.prometheus.mimir.input]
    logs    = [otelcol.exporter.loki.loki.input]
    traces  = [otelcol.exporter.otlp.tempo.input]
  }
}

// Convert OTel Metrics -> Prometheus
//
// Metrics arrive here by two routes. Almost all of them are scraped from the
// service's Prometheus registry below, where a relabel rule attaches the tier.
// The handful sent over OTLP by the OTel SDK skip that path entirely, so
// without the conversion their resource attributes — service.name,
// service.version and tier — collapse into target_info and the samples
// themselves carry no tier at all. One metric arriving unlabelled while every
// neighbour is labelled is the kind of gap noticed only when a query silently
// returns both tiers added together.
otelcol.exporter.prometheus "mimir" {
  resource_to_telemetry_conversion = true

  forward_to = [prometheus.remote_write.mimir.receiver]
}

// Convert OTel Logs -> Loki
otelcol.exporter.loki "loki" {
  forward_to = [loki.write.loki.receiver]
}

// Mimir (Metrics Storage)
prometheus.remote_write "mimir" {
  endpoint {
    url = "http://mimir:9009/api/v1/push"
  }
}

// Loki (Logs Storage)
loki.write "loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// Tempo (Traces Storage)
otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}

// ============================================
// Docker Logs Collection (Promtail replacement)
// ============================================

// Discover all Docker containers
discovery.docker "linux" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "5s"
}

// Relabel: Extract labels from Docker metadata
discovery.relabel "docker_logs" {
  targets = discovery.docker.linux.targets

  // Container ID
  rule {
    source_labels = ["__meta_docker_container_id"]
    target_label  = "container_id"
  }

  // Container Name (strip leading /)
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container_name"
  }

  // Image Name
  rule {
    source_labels = ["__meta_docker_container_image"]
    target_label  = "image_name"
  }

  // Service label (from docker-compose labels)
  rule {
    source_labels = ["__meta_docker_container_label_service"]
    target_label  = "service"
  }

  // Compose service name (fallback)
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "compose_service"
  }
}

// Collect Docker logs via Docker API
loki.source.docker "default" {
  host             = "unix:///var/run/docker.sock"
  targets          = discovery.relabel.docker_logs.output
  forward_to       = [loki.process.docker_logs.receiver]
  refresh_interval = "5s"
  relabel_rules    = discovery.relabel.docker_logs.rules
}

// Process logs: Parse JSON if present
loki.process "docker_logs" {
  forward_to = [loki.write.loki.receiver]

  // Add static job label
  stage.static_labels {
    values = {
      job = "docker",
    }
  }

  // Try to parse application JSON logs (backend, mimir, loki, tempo, grafana)
  stage.json {
    expressions = {
      level = "level",
      msg   = "msg",
    }
  }

  // Normalize level to UPPERCASE
  stage.template {
    source   = "level"
    template = "{{ ToUpper .Value }}"
  }

  // Add level as label if found
  stage.labels {
    values = {
      level = "",
    }
  }
}

// ============================================
// Prometheus Scrapers
// ============================================

// 1. Alloy Self-Monitoring
prometheus.scrape "alloy_self" {
  targets    = prometheus.exporter.self.default.targets
  forward_to = [prometheus.remote_write.mimir.receiver]
}

prometheus.exporter.self "default" {}

// 2. Mimir Monitoring
prometheus.scrape "mimir" {
  targets    = [{"__address__" = "mimir:9009"}]
  forward_to = [prometheus.remote_write.mimir.receiver]
}

// 3. Backend Monitoring
//
// Discovered rather than named. The single-tier stack runs one container called
// "service"; the two-tier dev stack runs "service-community" and
// "service-enterprise" and no "service" at all. A hardcoded address collects
// nothing on one of them while reporting no problem, so the containers are
// found by the label every one of them already carries.
discovery.relabel "easyp_service_metrics" {
  targets = discovery.docker.linux.targets

  // Only containers labelled as an easyp service.
  rule {
    source_labels = ["__meta_docker_container_label_service"]
    regex         = "easyp-api-.*"
    action        = "keep"
  }

  // Discovery yields the container's own address; the metrics port is 8081 on
  // every tier, whatever the host publishes it as.
  rule {
    source_labels = ["__meta_docker_network_ip"]
    target_label  = "__address__"
    replacement   = "$1:8081"
  }

  // Which tier a series came from, so the two can be told apart in a query.
  rule {
    source_labels = ["__meta_docker_container_label_service"]
    regex         = "easyp-api-(.*)"
    target_label  = "tier"
    replacement   = "$1"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container_name"
  }

  // instance defaults to the scrape address, which here is a container IP:
  // it names no tier a reader would recognise, and Docker hands out a new one
  // every time a container is recreated, so a panel grouped by instance shows
  // meaningless numbers that change under it. Dashboards group by instance by
  // convention — the stock ones here do so 65 times — so it is worth making
  // the label mean something. The container name is stable and says which tier.
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "instance"
  }
}

prometheus.scrape "service" {
  targets    = discovery.relabel.easyp_service_metrics.output
  forward_to = [prometheus.remote_write.mimir.receiver]
}

// 4. The Machine
//
// Everything else here measures the service. Nothing measured the box it runs
// on, and that gap had a cost: the disk reached 73% on a build cache nobody was
// watching, and it was found by hand, while looking for something else. There
// was no metric that could have said so and no alert that could have fired.
//
// node_exporter, embedded rather than run as its own container. The mounts it
// needs are on the alloy service in both compose files.
prometheus.exporter.unix "host" {
  // Read from the host's namespaces rather than this container's, which would
  // otherwise report the container's own filesystem and call it the machine.
  procfs_path = "/host/proc"
  sysfs_path  = "/host/sys"
  rootfs_path = "/host/root"

  // Named rather than inherited. The default set is around forty collectors,
  // and on a virtual machine a good half of them measure hardware that is not
  // there — thermal zones, fan sensors, RAPL energy counters. This list is also
  // the answer to "what do we actually collect", without reading upstream docs.
  set_collectors = [
    "cpu",
    "diskstats",
    "filesystem",
    "loadavg",
    "meminfo",
    "netdev",
    "stat",
    "uname",
    "vmstat",
  ]

  // The filesystem defaults are deliberately not overridden. They already drop
  // /dev, /proc, /sys and /var/lib/docker/..., and fs_types_exclude drops
  // overlay filesystems by type — which is what matters here, because ten
  // containers produce dozens of overlay mounts that all measure the same
  // physical disk. Excluding by type covers them however docker names them.
  filesystem { }
}

discovery.relabel "host_metrics" {
  targets = prometheus.exporter.unix.host.targets

  // Without this, instance is the exporter's internal address, which names
  // nothing a reader would recognise. One stack, one machine — the label is
  // here to say what the number is about, not to tell hosts apart. It becomes a
  // variable on the day there is a second one.
  rule {
    target_label = "instance"
    replacement  = "easyp-host"
  }
}

prometheus.scrape "host" {
  targets    = discovery.relabel.host_metrics.output
  forward_to = [prometheus.remote_write.mimir.receiver]
}

// 5. Loki Monitoring
prometheus.scrape "loki" {
  targets    = [{"__address__" = "loki:3100"}]
  forward_to = [prometheus.remote_write.mimir.receiver]
}

// 6. Grafana Monitoring
prometheus.scrape "grafana" {
  targets    = [{"__address__" = "grafana:3000"}]
  forward_to = [prometheus.remote_write.mimir.receiver]
}

// 7. Tempo Monitoring
prometheus.scrape "tempo" {
  targets    = [{"__address__" = "tempo:3200"}]
  forward_to = [prometheus.remote_write.mimir.receiver]
}
