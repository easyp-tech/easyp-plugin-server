          "legendFormat": "{{mountpoint}}",
          "refId": "A"
        }
      ],
      "title": "Free",
      "type": "stat"
    },
    {
      "datasource": "${DS_MIMIR}",
      "description": "Extrapolated from a day of trend, and blank until there is an hour of it — after a restart there is no history to extrapolate from. 999 means the disk is not filling. Under 4 days is what EasypHostDiskFillingUp alerts on.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 7
              },
              {
                "color": "green",
                "value": 30
              }
            ]
          },
          "unit": "d"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "${DS_MIMIR}",
          "expr": "clamp_max(node_filesystem_avail_bytes{instance=~\"$instance\",mountpoint=~\"$mountpoint\"} / clamp_min(-deriv(node_filesystem_avail_bytes{instance=~\"$instance\",mountpoint=~\"$mountpoint\"}[24h]), 1) / 86400, 999)\n      and (count_over_time(node_filesystem_avail_bytes{instance=~\"$instance\",mountpoint=~\"$mountpoint\"}[24h]) > 60)",
          "legendFormat": "{{mountpoint}}",
          "refId": "A"
        }
      ],
      "title": "Days Until Full",
      "type": "stat"
    },
