        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "${DS_MIMIR}",
          "expr": "1 - (node_filesystem_avail_bytes{instance=~\"$instance\",mountpoint=~\"$mountpoint\"} / node_filesystem_size_bytes{instance=~\"$instance\",mountpoint=~\"$mountpoint\"})",
          "legendFormat": "{{mountpoint}}",
          "refId": "A"
